# BARRONVISUAL Check · variables de entorno
# Copiar a .env.local para desarrollo. En producción, en Vercel (Settings → Environment Variables).
# Nunca pegar claves en el chat ni subirlas al repositorio.

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3020
NEXT_PUBLIC_CONTACT_EMAIL=info@barronvisual.com
# Correos con acceso a /admin (además de profiles.role = 'admin'), separados por comas
ADMIN_EMAILS=

# Supabase (Project Settings → API). Vale el formato nuevo (publishable/secret) o el antiguo (anon/service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic (IA). Modelo por defecto claude-opus-5-5; esfuerzo por defecto medium.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Stripe. Empezar SIEMPRE con claves sk_test_ (puerta de arranque: no cobrar en real sin alta y OK del titular).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
# Opcional: si existe, se ofrece el pago anual
STRIPE_PRICE_PRO_YEARLY=
# Opcional: tipo impositivo manual IVA 21 % incluido (txr_...), como en BARRON ACCESS
STRIPE_TAX_RATE_IVA=

# Correo (Brevo, API transaccional). El remitente debe estar verificado en Brevo.
BREVO_API_KEY=
EMAIL_FROM=info@barronvisual.com
EMAIL_FROM_NAME=BARRONVISUAL Check
# Transaccionales (bienvenida, pagos): true por defecto
EMAIL_ENABLED=true
# Comerciales (aviso de límite, recordatorio): apagados hasta que el titular abra la puerta de arranque
EMAIL_MARKETING_ENABLED=false

# Tarea diaria (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Días que se guardan las fotos (los informes en texto se conservan)
IMAGE_RETENTION_DAYS=30
